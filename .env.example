# ==============================================================================
# Alias AI - Environment Configuration
# ==============================================================================

# NVIDIA API Configuration (from https://build.nvidia.com)
# If left blank, Alias AI operates in High-Fidelity Local Simulation Mode ($0 cost)
NVIDIA_API_KEY=

# Local Edge Model Configuration (Gemma 2)
# Options: 'gemma2-9b', 'gemma2-2b', 'simulation'
LOCAL_EDGE_MODEL=gemma2-9b
LOCAL_MODEL_ENDPOINT=http://localhost:11434/v1

# Cloud Model Configuration (NVIDIA Nemotron-70B on GKE)
# Options: 'meta/llama-3.1-nemotron-70b-instruct', 'nvidia/nemotron-4-340b-instruct'
CLOUD_REASONING_MODEL=meta/llama-3.1-nemotron-70b-instruct
CLOUD_NIM_ENDPOINT=https://integrate.api.nvidia.com/v1

# Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=4200

# Security & Compliance
ENABLE_NEMO_GUARDRAILS=true
EU_AI_ACT_AUDIT_LOG=true
AES_VAULT_SECRET_KEY=alias-ai-local-in-memory-ephemeral-key-2026

